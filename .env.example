ZETRUV_ENVIRONMENT=dev
COMPOSE_PROJECT_NAME=zetruv-dev
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_DB=zetruv_dev
POSTGRES_USER=zetruv
POSTGRES_PASSWORD=change-me
JWT_KEY=replace-with-at-least-32-random-characters
CMS_ADMIN_EMAIL=admin-dev@zetruv.com
CMS_ADMIN_PASSWORD=change-me-now
FRONTEND_ORIGIN=https://zetruv.dualangka.com
CMS_ORIGIN=https://admin.zetruv.dualangka.com
API_PORT=8081
API_DOMAIN=api-dev.zetruv.dualangka.com
ORDER_ACCESS_TOKEN_LIFETIME_MINUTES=1440
# Set true when the API is reachable through the trusted VPS Nginx reverse proxy.
FORWARDED_HEADERS_ENABLED=true
# Mock providers are allowed only outside Production. Client production must use real providers.
PAYMENTS_PROVIDER=mock
PAYMENTS_MOCK_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
GAME_ACCOUNT_VALIDATION_PROVIDER=mock
SHIPPING_PROVIDER=mock
