POSTGRES_DB=zetruv
POSTGRES_USER=zetruv
POSTGRES_PASSWORD=change-me
JWT_KEY=replace-with-at-least-32-random-characters
CMS_ADMIN_EMAIL=admin@zetruv.com
CMS_ADMIN_PASSWORD=change-me-now
FRONTEND_ORIGIN=http://localhost:5173
CMS_ORIGIN=http://localhost:5174
API_PORT=8080
ORDER_ACCESS_TOKEN_LIFETIME_MINUTES=1440
# Set true only when the API is reachable exclusively through a trusted local reverse proxy.
# docker-compose binds the API to 127.0.0.1 so this is safe for the VPS Nginx topology.
FORWARDED_HEADERS_ENABLED=false
# Mock providers are for development/staging only. Production startup rejects them.
PAYMENTS_PROVIDER=mock
PAYMENTS_MOCK_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
GAME_ACCOUNT_VALIDATION_PROVIDER=mock
SHIPPING_PROVIDER=mock
